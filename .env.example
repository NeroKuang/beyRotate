# 複製為 .env.local（本機）或在 Zeabur 後台 Variables 貼上對應欄位

# --- 資料庫 ---
# 本機：docker compose 預設帳密
DATABASE_URL=postgresql://beyrotate:beyrotate_dev@localhost:5432/beyrotate
# Zeabur：DATABASE_URL=${POSTGRES_CONNECTION_STRING}

# --- Auth（必填）---
# NextAuth v4 讀 NEXTAUTH_*；AUTH_* 為別名（dev 腳本會自動對應）
AUTH_SECRET=
AUTH_URL=http://localhost:5001
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:5001
NEXT_PUBLIC_SITE_URL=http://localhost:5001
# SP 本機 dev 固定 5001；同機其他 SP 專案用 5002、5003…
# Zeabur：AUTH_URL=${ZEABUR_WEB_URL}、NEXT_PUBLIC_SITE_URL=${ZEABUR_WEB_URL}

ADMIN_EMAILS=your@email.com

# --- 物件儲存（MinIO / S3 相容）---
# 本機：對應 docker-compose minio
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=beyrotate
S3_SECRET_KEY=beyrotate_dev_minio
S3_REGION=us-east-1
# Zeabur MinIO 服務：用內網 endpoint + 公開網域當 S3_PUBLIC_URL（見 docs/DEPLOY-ZEABUR.md）

# --- Redis 搜尋快取（本機 docker compose 已含 redis 服務）---
REDIS_URL=redis://localhost:6379

# --- 選用 ---
CRON_SECRET=
# 首次 Zeabur 部署可暫設 RUN_DB_PUSH=1，schema 同步後改回 0
