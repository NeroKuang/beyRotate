{
  "name": "beyrotate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.local -e .env -- sh -c 'export NEXTAUTH_URL=${NEXTAUTH_URL:-$AUTH_URL}; export NEXTAUTH_SECRET=${NEXTAUTH_SECRET:-$AUTH_SECRET}; next dev -p 5001'",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:push": "dotenv -e .env.local -e .env -- prisma db push",
    "db:seed": "dotenv -e .env.local -e .env -- tsx prisma/seed.ts",
    "sync:catalog": "tsx scripts/sync-catalog.ts",
    "sync:parts": "tsx scripts/sync-parts.ts",
    "catalog:compare": "tsx scripts/compare-catalog.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:setup": "npm run db:push && npm run db:seed && npm run sync:catalog"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "ioredis": "^5.10.1",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
    "nodemailer": "^7.0.13",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
