generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- NextAuth ---
model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  emailVerified DateTime? @map("email_verified") @db.Timestamptz(6)
  passwordHash  String?   @map("password_hash")
  name          String?
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  accounts Account[]
  sessions Session[]
  profile  Profile?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- App ---
model Profile {
  id                   String    @id @db.Uuid
  displayName          String    @map("display_name")
  avatarUrl            String?   @map("avatar_url")
  bio                  String?
  region               String?
  lineId               String?   @map("line_id")
  discord              String?
  facebook             String?
  emailPublic          String?   @map("email_public")
  phone                String?
  isBanned             Boolean   @default(false) @map("is_banned")
  termsAcceptedAt      DateTime? @map("terms_accepted_at") @db.Timestamptz(6)
  onboardingCompleted  Boolean   @default(false) @map("onboarding_completed")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User          @relation(fields: [id], references: [id], onDelete: Cascade)
  settings     UserSettings?
  listings     Listing[]
  blocksGiven  UserBlock[]   @relation("blocker")
  blocksGot    UserBlock[]   @relation("blocked")

  @@map("profiles")
}

model UserSettings {
  userId                String   @id @map("user_id") @db.Uuid
  emailNotifyMessages   Boolean  @default(true) @map("email_notify_messages")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  blocker Profile @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Profile @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@map("user_blocks")
}

model CatalogCategory {
  id     String @id
  nameZh String @map("name_zh")

  products CatalogProduct[]

  @@map("catalog_categories")
}

model CatalogProduct {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String   @map("category_id")
  code       String
  series     String   @default("bx")
  meta       Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  category CatalogCategory  @relation(fields: [categoryId], references: [id])
  variants CatalogVariant[]

  @@unique([categoryId, code])
  @@index([code])
  @@index([series])
  @@map("catalog_products")
}

model CatalogVariant {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  packageType    String   @default("") @map("package_type")
  buildString    String   @map("build_string")
  packageLabelZh String?  @map("package_label_zh")
  bladeAbbr      String?  @map("blade_abbr")
  ratchetAbbr    String?  @map("ratchet_abbr")
  bitAbbr        String?  @map("bit_abbr")
  bladeNameZh    String?  @map("blade_name_zh")
  ratchetNameZh  String?  @map("ratchet_name_zh")
  bitNameZh      String?  @map("bit_name_zh")
  coat           String?
  regionTag      String?  @map("region_tag")
  youtubeId      String?  @map("youtube_id")
  meta           Json     @default("{}")
  displayLabel   String   @map("display_label")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product      CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  listingItems ListingItem[]

  @@unique([productId, packageType, buildString])
  @@index([displayLabel])
  @@map("catalog_variants")
}

model CatalogMeta {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("catalog_meta")
}

/** 單獨零件（刃體／核輪／軸心），來源 go-shoot part-*.json */
model CatalogPart {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partType     String   @map("part_type")
  abbr         String
  line         String   @default("")
  partGroup    String   @default("") @map("part_group")
  seriesScope  String   @default("all") @map("series_scope")
  nameZh       String   @map("name_zh")
  displayLabel String   @map("display_label")
  searchText   String   @default("") @map("search_text")
  meta         Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  listingItems ListingItem[]

  @@unique([partType, abbr, line, partGroup])
  @@index([partType])
  @@index([seriesScope])
  @@index([partGroup])
  @@index([displayLabel])
  @@map("catalog_parts")
}

enum ListingType {
  sell
  want
  trade
}

enum ListingStatus {
  draft
  active
  reserved
  sold
  closed
  hidden
}

enum ListingCondition {
  new
  like_new
  used
  parts
}

enum ContactPref {
  in_app
  external
  both
}

enum ItemRole {
  offer
  seek
}

enum ListingItemKind {
  variant
  part
  stadium
}

model Listing {
  id                            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                        String            @map("user_id") @db.Uuid
  type                          ListingType
  status                        ListingStatus     @default(draft)
  customTitle                   String?           @map("custom_title")
  price                         Int?
  budget                        Int?
  cashDiff                      Int?              @map("cash_diff")
  negotiable                    Boolean           @default(false)
  currency                      String            @default("TWD")
  condition                     ListingCondition?
  quantity                      Int               @default(1)
  region                        String?
  deliveryTags                  String[]          @default([]) @map("delivery_tags")
  note                          String?
  contactPref                   ContactPref       @default(in_app) @map("contact_pref")
  acceptInquiriesWhileReserved  Boolean           @default(true) @map("accept_inquiries_while_reserved")
  viewCount                     Int               @default(0) @map("view_count")
  publishedAt                   DateTime?         @map("published_at") @db.Timestamptz(6)
  createdAt                     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   ListingItem[]
  images  ListingImage[]
  ratings Rating[]

  @@index([status, publishedAt(sort: Desc)])
  @@map("listings")
}

model ListingItem {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId          String           @map("listing_id") @db.Uuid
  itemKind           ListingItemKind  @default(variant) @map("item_kind")
  catalogVariantId   String?          @map("catalog_variant_id") @db.Uuid
  catalogPartId      String?          @map("catalog_part_id") @db.Uuid
  sourceProductCode  String?          @map("source_product_code")
  sourcePartSpec     String?          @map("source_part_spec")
  quantity           Int              @default(1)
  price              Int?
  budget             Int?
  role               ItemRole
  seekText           String?          @map("seek_text")

  listing Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  variant CatalogVariant? @relation(fields: [catalogVariantId], references: [id])
  part    CatalogPart?    @relation(fields: [catalogPartId], references: [id])

  @@map("listing_items")
}

model ListingImage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId   String   @map("listing_id") @db.Uuid
  storagePath String   @map("storage_path")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_images")
}

model ListingView {
  listingId String   @map("listing_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)

  @@id([listingId, userId])
  @@map("listing_views")
}

model Conversation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId      String?   @map("listing_id") @db.Uuid
  participantA   String    @map("participant_a") @db.Uuid
  participantB   String    @map("participant_b") @db.Uuid
  lastMessageAt  DateTime? @map("last_message_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  messages Message[]

  @@unique([listingId, participantA, participantB])
  @@map("conversations")
}

model ConversationRead {
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  lastReadAt     DateTime @default(now()) @map("last_read_at") @db.Timestamptz(6)

  @@id([conversationId, userId])
  @@unique([conversationId, userId])
  @@map("conversation_reads")
}

model Message {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  body           String?
  imagePath      String?  @map("image_path")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

enum ReportTarget {
  listing
  user
}

enum ReportStatus {
  pending
  resolved
  dismissed
}

enum ReportReason {
  scam
  fake
  harassment
  spam
  bad_price
  prohibited
  other
}

model Report {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId String       @map("reporter_id") @db.Uuid
  targetType ReportTarget @map("target_type")
  targetId   String       @map("target_id") @db.Uuid
  reason     ReportReason
  note       String?
  status     ReportStatus @default(pending)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([reporterId, targetType, targetId])
  @@map("reports")
}

model Rating {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  raterId   String   @map("rater_id") @db.Uuid
  rateeId   String   @map("ratee_id") @db.Uuid
  score     Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, raterId])
  @@index([rateeId])
  @@map("ratings")
}

model AdminAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id") @db.Uuid
  reason     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("admin_audit_logs")
}
